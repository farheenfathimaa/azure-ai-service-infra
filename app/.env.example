# Copy to .env for local development. Never commit a populated .env.
APP_ENV=local
LOG_LEVEL=INFO

# "auto" prefers Azure OpenAI, then falls back to Groq, then echo.
LLM_PROVIDER=auto
ALLOW_FALLBACK=true

# Azure OpenAI (only used when LLM_PROVIDER allows it)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

# Groq fallback
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

ALLOW_BOOM=true
